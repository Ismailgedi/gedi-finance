APP_NAME="Gedi Finance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000,::1

# Optional development administrator. Set ADMIN_PASSWORD outside source control before seeding.
ADMIN_NAME=Dad
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional second Super Admin (Ismail). Leave ISMAIL_ADMIN_PASSWORD unset to
# skip provisioning this account entirely - set outside source control.
ISMAIL_ADMIN_EMAIL=
ISMAIL_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# InfinityFree UAT deployment reference (see /INFINITYFREE_DEPLOYMENT.md)
# ==============================================================================
# These values are NOT active here - they only document what the real .env
# on InfinityFree (created on the server, never committed) needs instead of
# the local-dev values above. Everything else in this file (SESSION_*,
# CACHE_STORE, QUEUE_CONNECTION, ...) keeps the same meaning there.
#
# APP_NAME="Gedi Finance"
# APP_ENV=production
# APP_KEY=                        # generate locally: php artisan key:generate --show
# APP_DEBUG=false
# APP_URL=https://YOUR-UAT-DOMAIN
# FRONTEND_URL=https://YOUR-UAT-DOMAIN
# SANCTUM_STATEFUL_DOMAINS=YOUR-UAT-DOMAIN
#
# DB_CONNECTION=mysql
# DB_HOST=sqlXXX.infinityfree.com     # from the InfinityFree control panel
# DB_PORT=3306
# DB_DATABASE=if0_XXXXXXXX_gedi_finance
# DB_USERNAME=if0_XXXXXXXX
# DB_PASSWORD=
#
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true          # InfinityFree UAT must be served over HTTPS
# SESSION_SAME_SITE=lax
#
# LOG_LEVEL=error                     # never 'debug' in a UAT/production environment
#
# Required to seed the Super Admin (DatabaseSeeder refuses to run without
# ADMIN_PASSWORD - see database/seeders/DatabaseSeeder.php). Set real
# values directly in the server's .env, never here.
# ADMIN_NAME="Gedi Finance Admin"
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
#
# Optional second Super Admin - leave ISMAIL_ADMIN_PASSWORD unset to skip
# provisioning this account entirely.
# ISMAIL_ADMIN_EMAIL=
# ISMAIL_ADMIN_PASSWORD=
#
# Only needed temporarily, to run migrate+db:seed via GET /deploy/seed
# (InfinityFree has no SSH/Artisan access - see routes/web.php and
# INFINITYFREE_UPLOAD_STEPS.md). Make up a long random value, remove this
# line again once you've used it once.
# SEED_TOKEN=
